# Copy to .env and fill in values. Never commit real secrets.
# .env is gitignored.

# QueryMind internal database (application records)
DATABASE_URL=postgresql+psycopg2://querymind:querymind@localhost:5433/querymind

# Target database to inspect (read-only, least-privilege)
# Register target connections through the MCP connect_database tool instead.
TARGET_DATABASE_URL=postgresql+psycopg2://readonly:readonly@localhost:5432/ecommerce

# Security
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Authentication
JWT_SECRET_KEY=change-me-in-production-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
REGISTRATION_ENABLED=true

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Server
QUERYMIND_ENV=development
LOG_LEVEL=info
MCP_TRANSPORT=stdio

# Limits
MAX_RESULT_ROWS=1000
STATEMENT_TIMEOUT_MS=10000
